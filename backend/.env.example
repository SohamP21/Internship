# Copy to .env and fill in values. MongoDB and JWT are required to run the API.

NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/eventify
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════════════════════
# OUTGOING EMAIL — Option B: Gmail + Nodemailer (required setup)
# ═══════════════════════════════════════════════════════════════════════════
# Used for: welcome after registration, new-event announcement (BCC), certificates.
#
# 1) Use a real Gmail address for EMAIL_USER (…@gmail.com).
# 2) Turn on 2-Step Verification on that Google account.
# 3) Google Account → Security → App passwords → create "Mail" / "Other" → copy the
#    16-character password into EMAIL_PASS (no spaces).
# 4) Do NOT set EMAIL_HOST or EMAIL_PORT for @gmail.com — the app forces smtp.gmail.com.
#
# Deployed server (Railway, Render, etc.): set the same variables in the host dashboard.
#
EMAIL_USER=yourname@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM_NAME=Eventify
APP_NAME=Eventify

# Optional — only if you use Outlook / SMTP instead of Gmail:
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587

# Judge registration protection
JUDGE_ACCESS_CODE=JUDGE2026

ADMIN_NAME=Eventify Admin
ADMIN_EMAIL=admin@eventify.local
ADMIN_PASSWORD=Admin@12345

STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=eventify_uploads
