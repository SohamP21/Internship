# Copy to .env and fill in values. MongoDB and JWT are required to run the API.

NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/eventify
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Used when NODE_ENV=production (reflecting origin is used in development)
CLIENT_URL=http://localhost:5173

# Optional — only needed when you call sendEmail()
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Judge registration protection
JUDGE_ACCESS_CODE=JUDGE2026

# Single hardcoded admin (coordinator)
ADMIN_NAME=Eventify Admin
ADMIN_EMAIL=admin@eventify.local
ADMIN_PASSWORD=Admin@12345

# Storage driver: local | cloudinary
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=eventify_uploads
